<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ pdf_title }}</title>
<meta name="author" content="{{ bank.name }} (synthetic)">
<meta name="keywords" content="synthetic, fake data, test data">
<meta name="description" content="SYNTHETIC bank statement with fabricated data for testing. Not a real document.">
<style>
  @page {
    size: A4;
    margin: 80mm 12mm 30mm 12mm;
    @top-left    { content: element(page-header); width: 186mm; vertical-align: top; }
    @bottom-left { content: element(page-footer); width: 186mm; vertical-align: top; }
  }
  html { font-family: "Liberation Sans", "DejaVu Sans", Arial, Helvetica, sans-serif; font-size: 8pt; color: #111; }
  body { margin: 0; }

  /* ---------- running header (repeats on every page) ---------- */
  #page-header { position: running(page-header); width: 186mm; }
  .pageno { text-align: center; font-size: 8pt; margin-bottom: 1mm; }
  .pageno::after { content: counter(page); }
  .hdr-table { width: 100%; border-collapse: collapse; }
  .hdr-table td { vertical-align: top; padding: 0; }
  .logo img { height: 14mm; }
  .cust-box { border: 1.2pt solid #000; padding: 2.5mm 3mm; width: 78mm; margin-top: 3mm; line-height: 1.55; font-size: 7.6pt; }
  .cust-box .jh { margin-top: 3mm; }
  .nomination { font-size: 7.4pt; margin: 1mm 0 0 3mm; }
  .acct { width: 100%; border-collapse: collapse; font-size: 7pt; line-height: 1.35; }
  .acct td { vertical-align: top; padding: 0 0 0.3mm 0; }
  .acct td.k { width: 25mm; white-space: nowrap; }
  .acct td.sep { width: 3mm; }
  .period { margin-top: 2mm; font-size: 7.6pt; }
  .period span { display: inline-block; }
  .period .to { margin-left: 18mm; }
  .stmt-title { font-size: 11pt; margin: 2mm 0 0 0; text-align: center; font-weight: normal; }

  /* ---------- running footer (repeats on every page) ---------- */
  #page-footer { position: running(page-footer); width: 186mm; font-size: 6.4pt; line-height: 1.3; padding-top: 2mm; }
  #page-footer .legal-name { color: #0b3d91; font-weight: bold; font-size: 8.5pt; }
  #page-footer .note { color: #0b3d91; font-size: 7pt; }

  /* ---------- transaction table ---------- */
  table.txn { width: 100%; border-collapse: collapse; table-layout: fixed; border: 0.7pt solid #2a8a8a; }
  table.txn thead { display: table-header-group; }
  table.txn th { background: #e6f2f2; border: 0.7pt solid #2a8a8a; padding: 1.2mm 1mm; font-size: 7.4pt; text-align: center; }
  table.txn td { border-left: 0.7pt solid #2a8a8a; border-right: 0.7pt solid #2a8a8a; padding: 1.2mm 1mm; vertical-align: top; font-size: 7.2pt; line-height: 1.3; }
  table.txn tr { page-break-inside: avoid; }
  table.txn tbody tr:last-child td { border-bottom: 0.7pt solid #2a8a8a; }
  td.num { text-align: right; }
  td.narr { word-break: break-all; overflow-wrap: anywhere; }
  td.ctr { text-align: center; }
  col.c-date { width: 15mm; } col.c-narr { width: 62mm; } col.c-ref { width: 27mm; }
  col.c-val { width: 15mm; } col.c-wd { width: 22mm; } col.c-dp { width: 19mm; } col.c-bal { width: 26mm; }

  /* ---------- end-of-statement block (last page only, flows after the table) ---------- */
  .summary { margin-top: 6mm; page-break-inside: avoid; }
  .summary h4 { margin: 0 0 1mm 0; font-size: 9pt; }
  .summary table { border-collapse: collapse; width: 100%; }
  .summary th { font-size: 7.4pt; text-align: center; padding: 0.8mm 2mm; border-bottom: 0.7pt solid #444; }
  .summary td { text-align: center; padding: 1mm 2mm; font-size: 7.6pt; }
  .gen { margin-top: 12mm; page-break-inside: avoid; }
  .gen table { width: 100%; border-collapse: collapse; }
  .gen td { font-size: 7.6pt; font-weight: bold; padding: 0; }
  .cg-note { margin-top: 14mm; text-align: right; font-size: 7.6pt; }
</style>
</head>
<body>

<!-- ===== header: repeated on every page via position: running ===== -->
<div id="page-header">
  <div class="pageno">Page No.: </div>
  <table class="hdr-table"><tr>
    <td style="width:100mm;">
      <div class="logo"><img src="{{ logo_uri }}" alt="{{ bank.name }}"></div>
      <div class="cust-box">
        {{ customer.title }} {{ customer.name }}<br>
        {% for line in customer.address_lines %}{{ line }}<br>{% endfor %}
        <div class="jh">JOINT HOLDERS : {{ customer.joint_holders | join(', ') }}</div>
      </div>
      <div class="nomination">Nomination : {{ account.nomination }}</div>
    </td>
    <td>
      <table class="acct">
        <tr><td class="k">Account Branch</td><td class="sep">:</td><td>{{ branch.name }}</td></tr>
        <tr><td class="k">Address</td><td class="sep">:</td><td>{% for line in branch.address_lines %}{{ line }}<br>{% endfor %}</td></tr>
        <tr><td class="k">City</td><td class="sep">:</td><td>{{ branch.city }} {{ branch.pincode }}</td></tr>
        <tr><td class="k">State</td><td class="sep">:</td><td>{{ branch.state }}</td></tr>
        <tr><td class="k">Phone no.</td><td class="sep">:</td><td>{{ branch.phones | join('/') }}</td></tr>
        <tr><td class="k">OD Limit</td><td class="sep">:</td><td>{{ od_limit }}</td></tr>
        <tr><td class="k">Currency</td><td class="sep">:</td><td>{{ account.currency }}</td></tr>
        <tr><td class="k">Email</td><td class="sep">:</td><td>{{ account.email }}</td></tr>
        <tr><td class="k">Cust ID</td><td class="sep">:</td><td>{{ account.cust_id }}</td></tr>
        <tr><td class="k">Account No</td><td class="sep">:</td><td>{{ account.account_no }} {{ account.account_variant }}</td></tr>
        <tr><td class="k">A/C Open Date</td><td class="sep">:</td><td>{{ open_date }}</td></tr>
        <tr><td class="k">Account Status</td><td class="sep">:</td><td>{{ account.status }}</td></tr>
        <tr><td class="k">RTGS/NEFT IFSC</td><td class="sep">:</td><td>{{ branch.ifsc }} &nbsp;&nbsp; MICR : {{ branch.micr }}</td></tr>
        <tr><td class="k">Branch Code</td><td class="sep">:</td><td>{{ branch.branch_code }}</td></tr>
        <tr><td class="k">Account Type</td><td class="sep">:</td><td>{{ account.type }}({{ account.type_code }})</td></tr>
      </table>
    </td>
  </tr></table>
  <div class="period"><span>From : {{ period_from }}</span><span class="to">To : {{ period_to }}</span></div>
  <div class="stmt-title">{{ statement.title }}</div>
</div>

<!-- ===== footer: repeated on every page ===== -->
<div id="page-footer">
  <div class="legal-name">{{ bank.legal_name }}</div>
  <div class="note">{{ footer.closing_balance_note }}</div>
  <div>{{ footer.disclaimer }}</div>
  <div><b>State account branch GSTN:{{ bank.gst_state_account_branch_gstn }}</b></div>
  <div>{{ bank.legal_name | title }} GSTIN number details are available at {{ bank.gst_info_url }}</div>
  <div>Registered Office Address: {{ bank.registered_office }}</div>
</div>

<!-- ===== transactions ===== -->
<table class="txn">
  <colgroup>
    <col class="c-date"><col class="c-narr"><col class="c-ref"><col class="c-val">
    <col class="c-wd"><col class="c-dp"><col class="c-bal">
  </colgroup>
  <thead>
    <tr>
      <th>Date</th><th>Narration</th><th>Chq./Ref.No.</th><th>Value Dt</th>
      <th>Withdrawal Amt.</th><th>Deposit Amt.</th><th>Closing Balance</th>
    </tr>
  </thead>
  <tbody>
  {% for r in rows %}
    <tr>
      <td class="ctr">{{ r.date }}</td>
      <td class="narr">{{ r.narration }}</td>
      <td class="ctr">{{ r.ref_no }}</td>
      <td class="ctr">{{ r.value_date }}</td>
      <td class="num">{{ r.withdrawal }}</td>
      <td class="num">{{ r.deposit }}</td>
      <td class="num">{{ r.balance }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>

<!-- ===== end of statement (appears once, after the last row) ===== -->
<div class="summary">
  <h4>STATEMENT SUMMARY :-</h4>
  <table>
    <tr><th>Opening Balance</th><th>Dr Count</th><th>Cr Count</th><th>Debits</th><th>Credits</th><th>Closing Bal</th></tr>
    <tr><td>{{ summary.opening_balance }}</td><td>{{ summary.dr_count }}</td><td>{{ summary.cr_count }}</td>
        <td>{{ summary.debits }}</td><td>{{ summary.credits }}</td><td>{{ summary.closing_balance }}</td></tr>
  </table>
</div>

<div class="gen">
  <table><tr>
    <td>Generated On: {{ generated_on }}</td>
    <td style="text-align:center;">Generated By: {{ statement.generated_by }}</td>
    <td style="text-align:right;">Requesting Branch Code: {{ statement.requesting_branch_code }}</td>
  </tr></table>
  <div class="cg-note">{{ footer.computer_generated_note }}</div>
</div>

</body>
</html>
